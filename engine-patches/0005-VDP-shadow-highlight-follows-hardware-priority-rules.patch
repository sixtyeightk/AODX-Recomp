From 54d5b2ebf8ef2336e9c3739cd12abcaf89263efe Mon Sep 17 00:00:00 2001
From: sixtyeightk <sixtyeightk@users.noreply.github.com>
Date: Sun, 25 Oct 2026 18:27:41 -0400
Subject: [PATCH 05/18] VDP: shadow/highlight follows hardware priority rules

- Planes are normal intensity where either plane's TILE has priority, even if
  that tile's pixel is transparent (games light areas with transparent
  high-priority tiles; Arcus Odyssey's lighting layer). Previously only
  opaque high-priority pixels counted, so lit areas rendered shadowed.
- Operator pixels (palette 3 colour 14/15) occupy the sprite layer like any
  opaque pixel (first wins) and only act when the sprite is visible
  (high priority, or no opaque high-priority plane pixel).
- Highlight raises one step (shadow->normal->highlight); colour 14 of sprite
  palettes 0-2 is never shadowed.
Verified: Arcus act starts pixel-identical to Genesis Plus GX (8/8).
---
 runner/video/genesis_vdp.c | 103 +++++++++++++++++++------------------
 1 file changed, 53 insertions(+), 50 deletions(-)

diff --git a/runner/video/genesis_vdp.c b/runner/video/genesis_vdp.c
index 7516e57..85bfd1a 100644
--- a/runner/video/genesis_vdp.c
+++ b/runner/video/genesis_vdp.c
@@ -713,17 +713,16 @@ static void sprite_render_line(GVDP *v, int line, int total, int offset)
                     int nib = (bits >> (28 - (fx ^ (hf ? 7 : 0)) * 4)) & 15;
                     if (!nib) continue;
                     if (drawn[sx]) { v->sprite_collision = 1; continue; }
+                    /* Operators occupy the layer: the first opaque pixel wins. */
                     if (sh_mode && pal == 3 && nib == 14)
                         s_spr_hilite_op[sx] = 1;
                     else if (sh_mode && pal == 3 && nib == 15)
                         s_spr_shadow_op[sx] = 1;
-                    else {
-                        s_spr_idx[sx] = ext?(uint8_t)(GVDP_HOST_PALETTE_BASE+(ext-1)*16+nib)
-                                          :(uint8_t)(pal*16+nib);
-                        s_spr_op[sx] = 1;
-                        s_spr_hi[sx] = (uint8_t)pri;
-                        drawn[sx] = 1;
-                    }
+                    s_spr_idx[sx] = ext?(uint8_t)(GVDP_HOST_PALETTE_BASE+(ext-1)*16+nib)
+                                      :(uint8_t)(pal*16+nib);
+                    s_spr_op[sx] = 1;
+                    s_spr_hi[sx] = (uint8_t)pri;
+                    drawn[sx] = 1;
                 }
             }
 #else
@@ -742,18 +741,17 @@ static void sprite_render_line(GVDP *v, int line, int total, int offset)
 
                 if (drawn[sx]) { v->sprite_collision = 1; continue; } /* first wins */
 
-                if (sh_mode && pal == 3 && nib == 14) {        /* highlight op */
+                /* Operators occupy the layer: the first opaque pixel wins. */
+                if (sh_mode && pal == 3 && nib == 14)          /* highlight op */
                     s_spr_hilite_op[sx] = 1;
-                } else if (sh_mode && pal == 3 && nib == 15) { /* shadow op    */
+                else if (sh_mode && pal == 3 && nib == 15)     /* shadow op    */
                     s_spr_shadow_op[sx] = 1;
-                } else {
-                    int ext = pal == 0 ? gvdp_sprite_pattern_line(sz,(unsigned)tileno) : 0;
-                    s_spr_idx[sx] = ext ? (uint8_t)(GVDP_HOST_PALETTE_BASE + (ext - 1) * 16 + nib)
-                                        : (uint8_t)(pal * 16 + nib);
-                    s_spr_op[sx]  = 1;
-                    s_spr_hi[sx]  = (uint8_t)pri;
-                    drawn[sx] = 1;
-                }
+                int ext = pal == 0 ? gvdp_sprite_pattern_line(sz,(unsigned)tileno) : 0;
+                s_spr_idx[sx] = ext ? (uint8_t)(GVDP_HOST_PALETTE_BASE + (ext - 1) * 16 + nib)
+                                    : (uint8_t)(pal * 16 + nib);
+                s_spr_op[sx]  = 1;
+                s_spr_hi[sx]  = (uint8_t)pri;
+                drawn[sx] = 1;
             }
 
 #endif
@@ -1025,44 +1023,49 @@ int gvdp_render_scanline(GVDP *v, int line, uint8_t *out)
                           (x - hs_b), (line + vs_b), im2, &b_idx, &b_op, &b_hi);
 #endif
 
-        /* Sprite layer (indexed in output-column space). */
+#if GENESIS_BATCHED_PLANES
+        /* Span metadata: bit 7 = tile priority (kept for transparent pixels),
+         * bit 6 = opaque, bits 5-0 = palette index. */
+        int a_op = (plane_a[xo] >> 6) & 1, a_hi = plane_a[xo] >> 7;
+        int b_op = (plane_b[xo] >> 6) & 1, b_hi = plane_b[xo] >> 7;
+#endif
+        /* Sprite layer (indexed in output-column space). In shadow/highlight
+         * mode an operator pixel (palette 3, colour 14/15) occupies the sprite
+         * layer like any opaque pixel but shows the layer beneath it. */
         int s_op = s_spr_op[xo], s_hi = s_spr_hi[xo];
+        int s_shadow = s_spr_shadow_op[xo], s_hilite = s_spr_hilite_op[xo];
         uint8_t s_idx = s_spr_idx[xo];
 
         /* Genesis priority order: S-hi > A-hi > B-hi > S-lo > A-lo > B-lo > bg. */
-        uint8_t px;
-#if GENESIS_BATCHED_PLANES
-        unsigned key = (plane_a[xo] >> 6) | ((plane_b[xo] >> 6) << 2) |
-            ((unsigned)(s_op | (s_hi << 1)) << 4);
-        unsigned selection = s_layer_select[key];
-        uint32_t colors = (uint32_t)backdrop | ((uint32_t)b_idx << 8) |
-            ((uint32_t)a_idx << 16) | ((uint32_t)s_idx << 24);
-        px = (uint8_t)(colors >> ((selection & 3) * 8));
-#else
-        if      (s_op && s_hi) px = s_idx;
-        else if (a_op && a_hi) px = a_idx;
-        else if (b_op && b_hi) px = b_idx;
-        else if (s_op)         px = s_idx;
-        else if (a_op)         px = a_idx;
-        else if (b_op)         px = b_idx;
-        else                   px = backdrop;
-#endif
-
-        /* Shadow/highlight: when enabled, a pixel with no high-priority layer
-         * is shadowed; operator sprites (pal3 colours 14/15) force highlight or
-         * shadow on the underlying pixel. */
+        uint8_t bg; int bg_hi;
+        if      (a_op && a_hi) { bg = a_idx;    bg_hi = 1; }
+        else if (b_op && b_hi) { bg = b_idx;    bg_hi = 1; }
+        else if (a_op)         { bg = a_idx;    bg_hi = 0; }
+        else if (b_op)         { bg = b_idx;    bg_hi = 0; }
+        else                   { bg = backdrop; bg_hi = 0; }
+        int s_vis = s_op && (s_hi || !bg_hi);
+        uint8_t px = (s_vis && !s_shadow && !s_hilite) ? s_idx : bg;
+
+        /* Shadow/highlight intensity:
+         *  - planes: normal if either plane's TILE has priority at this pixel,
+         *    even where that tile's pixel is transparent (games light areas
+         *    with transparent high-priority tiles); otherwise shadowed;
+         *  - a visible shadow operator shadows the pixel beneath it; a
+         *    highlight operator raises it one step (shadow -> normal ->
+         *    highlight);
+         *  - a visible high-priority sprite is normal; a low-priority one
+         *    takes the planes' intensity; colour 14 of palettes 0-2 is never
+         *    shadowed. */
         if (sh_mode && px < GVDP_CRAM_ENTRIES) {
-#if GENESIS_BATCHED_PLANES
-            int hi_present = selection & 4;
-#else
-            int hi_present = (s_op && s_hi) || (a_op && a_hi) || (b_op && b_hi);
-#endif
-            int sh = !hi_present;
-            int hl = 0;
-            if (s_spr_shadow_op[xo]) sh = 1;
-            if (s_spr_hilite_op[xo]) { if (sh) sh = 0; else hl = 1; }
-            if (hl)      px += GVDP_PALETTE_HIGHLIGHT;
-            else if (sh) px += GVDP_PALETTE_SHADOW;
+            int normal = a_hi || b_hi;
+            int level;                      /* 0 shadow, 1 normal, 2 highlight */
+            if (!s_vis)                         level = normal;
+            else if (s_shadow)                  level = 0;
+            else if (s_hilite)                  level = normal + 1;
+            else if ((s_idx & 0x0F) == 14 && s_idx < 48) level = 1;
+            else                                level = s_hi || normal;
+            if (level == 2)      px += GVDP_PALETTE_HIGHLIGHT;
+            else if (level == 0) px += GVDP_PALETTE_SHADOW;
         }
 
         out[xo] = px;
-- 
