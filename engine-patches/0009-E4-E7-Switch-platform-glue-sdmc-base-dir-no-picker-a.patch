diff --git a/runner/platform_switch.c b/runner/platform_switch.c
new file mode 100644
index 0000000..d9479ca
--- /dev/null
+++ b/runner/platform_switch.c
@@ -0,0 +1,121 @@
+/*
+ * platform_switch.c — Nintendo Switch (libnx) platform glue; see
+ * platform_switch.h. Empty unless GENESIS_PLATFORM_SWITCH.
+ *
+ * Applet model: libnx's default focus handling (SuspendHomeSleep) lets the
+ * system suspend the whole process while the HOME menu is open or the
+ * console sleeps, so emulation stops by itself there. For the remaining
+ * out-of-focus states (an overlay library applet, or a focus handling mode
+ * that keeps the process running) genesis_switch_frame() pauses the frame
+ * loop itself. Either way, when focus returns the SDL audio device is closed
+ * and reopened: audren output can stay silent after a suspension otherwise.
+ */
+#include "platform_switch.h"
+
+#if GENESIS_PLATFORM_SWITCH
+
+#include <switch.h>
+#include <SDL2/SDL.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#include "audio.h"
+
+#ifndef GENESIS_SWITCH_APP_DIR
+#define GENESIS_SWITCH_APP_DIR "genesis-recomp"
+#endif
+
+static char s_base_dir[512];
+
+static const char *sdmc_root(void)
+{
+#if defined(__SWITCH__)
+    return "sdmc:/";
+#else
+    /* Switch-stub desktop build: map sdmc:/ onto a local folder. */
+    static char root[480];
+    if (!root[0]) {
+        const char *r = getenv("GENESIS_FAKE_SDMC");
+        snprintf(root, sizeof root, "%s/", (r && r[0]) ? r : "fake-sdmc");
+        char dir[480];
+        snprintf(dir, sizeof dir, "%s", root);
+        dir[strlen(dir) - 1] = '\0';
+        mkdir(dir, 0777);
+    }
+    return root;
+#endif
+}
+
+const char *genesis_switch_base_dir(void)
+{
+    if (!s_base_dir[0]) {
+        char dir[512];
+        snprintf(dir, sizeof dir, "%sswitch", sdmc_root());
+        mkdir(dir, 0777);                       /* normally exists already */
+        snprintf(dir, sizeof dir, "%sswitch/%s", sdmc_root(), GENESIS_SWITCH_APP_DIR);
+        mkdir(dir, 0777);
+        snprintf(s_base_dir, sizeof s_base_dir, "%s/", dir);
+    }
+    return s_base_dir;
+}
+
+void genesis_switch_open_log(void)
+{
+#if defined(__SWITCH__)
+    char path[600];
+    snprintf(path, sizeof path, "%slog.txt", genesis_switch_base_dir());
+    if (freopen(path, "w", stderr))
+        setvbuf(stderr, NULL, _IOLBF, 1024);
+#endif
+}
+
+static AppletHookCookie s_hook_cookie;
+static volatile int s_focus_event;   /* set from appletMainLoop (main thread) */
+
+static void applet_hook(AppletHookType hook, void *param)
+{
+    (void)param;
+    if (hook == AppletHookType_OnFocusState || hook == AppletHookType_OnResume)
+        s_focus_event = 1;
+}
+
+void genesis_switch_init(void)
+{
+    appletHook(&s_hook_cookie, applet_hook, NULL);
+    fprintf(stderr, "[switch] base dir %s, operation mode %s\n", genesis_switch_base_dir(),
+            appletGetOperationMode() == AppletOperationMode_Console ? "docked" : "handheld");
+}
+
+int genesis_switch_frame(void)
+{
+    int paused = 0;
+    while (appletGetFocusState() != AppletFocusState_InFocus) {
+        if (!paused) {
+            paused = 1;
+            audio_set_playback_enabled(0);
+            fprintf(stderr, "[switch] out of focus: emulation paused\n");
+        }
+        int quit = !appletMainLoop();
+        SDL_PumpEvents();
+        if (quit || SDL_PeepEvents(NULL, 0, SDL_PEEKEVENT, SDL_QUIT, SDL_QUIT) > 0) {
+            SDL_Event ev;
+            memset(&ev, 0, sizeof ev);
+            ev.type = SDL_QUIT;
+            SDL_PushEvent(&ev);
+            return 0;
+        }
+        svcSleepThread(10000000LL);   /* 10 ms */
+    }
+    if (paused || s_focus_event) {
+        s_focus_event = 0;
+        int ok = audio_reopen() == 0;
+        fprintf(stderr, "[switch] in focus again: %s\n",
+                ok ? "audio reopened" : "no audio device to reopen");
+    }
+    return 1;
+}
+
+#endif /* GENESIS_PLATFORM_SWITCH */
diff --git a/runner/platform_switch.h b/runner/platform_switch.h
new file mode 100644
index 0000000..8094bbf
--- /dev/null
+++ b/runner/platform_switch.h
@@ -0,0 +1,41 @@
+/*
+ * platform_switch.h — Nintendo Switch (libnx) platform glue for the runner.
+ *
+ * GENESIS_PLATFORM_SWITCH is 1 on the console (__SWITCH__) and in a desktop
+ * build that compiles these same code paths against libnx stubs
+ * (GENESIS_SWITCH_STUBS, which supplies its own <switch.h>), so the Switch
+ * paths can run in a headless desktop test suite. Elsewhere it is 0 and
+ * platform_switch.c compiles to nothing.
+ */
+#ifndef RUNNER_PLATFORM_SWITCH_H
+#define RUNNER_PLATFORM_SWITCH_H
+
+#if defined(__SWITCH__) || defined(GENESIS_SWITCH_STUBS)
+#define GENESIS_PLATFORM_SWITCH 1
+#else
+#define GENESIS_PLATFORM_SWITCH 0
+#endif
+
+#if GENESIS_PLATFORM_SWITCH
+/* Application folder on the SD card, with a trailing slash:
+ * "sdmc:/switch/<GENESIS_SWITCH_APP_DIR>/". Created on first use. Settings,
+ * saves, states and runtime evidence live here (there is no exe directory).
+ * Stub builds map "sdmc:/" to $GENESIS_FAKE_SDMC (default ./fake-sdmc/). */
+const char *genesis_switch_base_dir(void);
+
+/* On the console, send stderr (the runner's log) to <base dir>/log.txt,
+ * line-buffered; nothing else would show it. A no-op in stub builds. */
+void genesis_switch_open_log(void);
+
+/* After SDL_Init: register the applet hooks (focus, resume). */
+void genesis_switch_init(void);
+
+/* Once per host frame, after SDL events were pumped. While the app is out of
+ * focus (HOME menu, sleep, an overlay applet) this blocks with audio paused,
+ * pumping events, and returns when focus is back; it then reopens the audio
+ * device (audren can come back silent otherwise). Returns 0 when the system
+ * asked the app to exit (an SDL_QUIT is queued as well), else 1. */
+int genesis_switch_frame(void);
+#endif
+
+#endif /* RUNNER_PLATFORM_SWITCH_H */
