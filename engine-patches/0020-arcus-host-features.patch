+    genesis_switch_log_memory("start");
+}
+
+void genesis_switch_log_memory(const char *when)
+{
+    u64 total = 0, used = 0;
+    svcGetInfo(&total, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0);
+    svcGetInfo(&used, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0);
+    int type = (int)appletGetAppletType();
+    fprintf(stderr, "[memory] %s: %s, process total %.1f MB, used %.1f MB", when,
+            type == 0 ? "application (full memory: an NSP, or title override)" :
+            type == 2 ? "library applet (applet mode: hbmenu from the Album)" : "other applet",
+            total / 1048576.0, used / 1048576.0);
+#if defined(__SWITCH__)
+    if (envHasHeapOverride())
+        fprintf(stderr, ", heap given by the loader %.1f MB", envGetHeapOverrideSize() / 1048576.0);
+    struct mallinfo mi = mallinfo();
+    fprintf(stderr, ", C heap in use %.1f MB (arena high water %.1f MB)",
+            mi.uordblks / 1048576.0, mi.arena / 1048576.0);
+#endif
+    fputc('\n', stderr);
+    fflush(stderr);
 }
 
