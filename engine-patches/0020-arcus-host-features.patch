+/* Applet trace (HOME -> + investigation, 2026-11-12): every hook libnx reports, with the
+ * focus state and the time since start, flushed at once (the log is otherwise buffered, and
+ * a hang loses it). Cheap: these only fire on HOME, sleep, mode changes and the like. */
+static double since_start(void)
+{
+    return (double)armTicksToNs(armGetSystemTick()) / 1e9;
+}
+
 static void applet_hook(AppletHookType hook, void *param)
 {
     (void)param;
+    static const char *const NAME[] = { "focus state", "operation mode", "performance mode",
+                                        "exit request", "resume", "capture button",
+                                        "album screenshot", "request to display" };
+    const char *n = (unsigned)hook < sizeof NAME / sizeof NAME[0] ? NAME[hook] : "?";
+    fprintf(stderr, "[applet] %.3f s: hook %d (%s), focus %d\n", since_start(), (int)hook, n,
+            (int)appletGetFocusState());
+    fflush(stderr);
     if (hook == AppletHookType_OnFocusState || hook == AppletHookType_OnResume)
         s_focus_event = 1;
 }
@@ -91,6 +109,28 @@
     appletHook(&s_hook_cookie, applet_hook, NULL);
     fprintf(stderr, "[switch] base dir %s, operation mode %s\n", genesis_switch_base_dir(),
