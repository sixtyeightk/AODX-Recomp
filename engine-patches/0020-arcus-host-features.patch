+/* Run one of the game's own routines (ending in RTS) to completion from the host, between
+ * frames: a game's host module asking the game to redraw something after changing its RAM.
+ * Delivered like own_deliver_vint: CPU state saved and restored, run on the interrupt stack
+ * (its 256 bytes kept), budget yields gated. The routine's cycles are not charged (the
+ * cycle counters are restored), as for any host-side RAM write. Only call it while the game
+ * fiber is suspended (frame hooks, input sampling), never from generated code. */
+void glue_run_guest_routine(uint32_t addr)
+{
+    const uint32_t STK = g_game_layout.intr_stack;
+    uint32_t byteoff = (STK - 256u) & 0xFFFFu;
+    uint8_t save[256];
+    M68KState saved = g_cpu;
+    int saved_split_sp_popped = recomp_interrupt_context_enter();
+    for (int i = 0; i < 256; i++) save[i] = g_ram[(byteoff + i) & 0xFFFFu];
+    uint32_t saved_acc = g_cycle_accumulator, saved_audio = g_audio_cycle_counter;
+    g_cpu.A[7] = STK;
+    s_in_vblank_service = 1;
+    g_rte_pending = 0; g_rte_pending_ptr = &s_rte_dummy; g_rte_pending = 0;
+    recomp_call_addr(addr & 0xFFFFFFu);
+    g_rte_pending_ptr = &s_rte_real; g_rte_pending = 0;
+    s_in_vblank_service = 0;
+    g_cycle_accumulator = saved_acc;
+    g_audio_cycle_counter = saved_audio;
+    for (int i = 0; i < 256; i++) g_ram[(byteoff + i) & 0xFFFFu] = save[i];
+    g_cpu = saved;
+    recomp_interrupt_context_leave(saved_split_sp_popped);
 }
 
