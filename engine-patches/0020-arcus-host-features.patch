+/* GENESIS_AUDIO_SOLO=<n> (capture aid, e.g. isolating a game sound effect from the music
+ * for a trailer): only FM channel n (1-6) is heard. Key-ons of the other FM channels are
+ * dropped, the DAC is fed silence and every PSG channel stays at volume off. Unset: no-op. */
+static int solo_filter(uint8_t port, uint8_t *value)
+{
+    static int solo = -1;
+    static uint8_t addr[2];
+    if (solo < 0) { const char *e = getenv("GENESIS_AUDIO_SOLO"); solo = (e && *e) ? atoi(e) : 0; }
+    if (!solo) return 1;
+    if (port == AUDIO_PORT_FM1_ADDR || port == AUDIO_PORT_FM2_ADDR) { addr[port >> 1] = *value; return 1; }
+    if (port == AUDIO_PORT_FM1_DATA && addr[0] == 0x28) {      /* key on/off: d0-2 = channel */
+        int c = *value & 7, ch = c < 3 ? c + 1 : c;              /* 0,1,2 -> 1,2,3; 4,5,6 -> 4,5,6 */
+        if (ch != solo) *value &= 0x0F;                          /* operators off */
+        return 1;
+    }
+    if (port == AUDIO_PORT_FM1_DATA && addr[0] == 0x2A) { *value = 0x80; return 1; }   /* DAC: silence */
+    if (port == AUDIO_PORT_PSG && (*value & 0x90) == 0x90) *value |= 0x0F;          /* PSG volume: off */
+    return 1;
+}
+
 void audio_event_push(uint32_t cycle_stamp, uint8_t port, uint8_t value)
 {
+    solo_filter(port, &value);
 #ifdef GENESIS_COSIM
     hist_record(cycle_stamp, port, value);
 #endif
