+/* Host pause (menus, rewind): hold the output instead of starving the bridge
+ * (a starved bridge conceals the gap by looping recent audio, which sounds
+ * like the current effect repeating). The device keeps running: the callback
+ * fades what is playing out over 10 ms, then plays silence. Stopping the
+ * device instead cut the wave mid-cycle, an audible click (and some backends
+ * replay their last queued buffer). On resume the ring restarts empty and the
  * bridge's pre-roll fades back in. */
 void audio_pause(int paused)
 {
     static int s_paused = 0;
     if (s_dev == 0 || paused == s_paused) return;
     s_paused = paused;
+    SDL_LockAudioDevice(s_dev);
+    double fill = s_bridge_ready ? rab_fill_ms(&s_bridge) : 0.0;
     if (paused) {
-        SDL_PauseAudioDevice(s_dev, 1);
+        s_hold = 1;
+        s_hold_fade = PAUSE_FADE_FRAMES;
     } else {
-        SDL_LockAudioDevice(s_dev);
         if (s_bridge_ready) rab_reset(&s_bridge);
-        SDL_UnlockAudioDevice(s_dev);
-        SDL_PauseAudioDevice(s_dev, 0);
-    }
+        s_hold = 0;
+    }
+    SDL_UnlockAudioDevice(s_dev);
+    fprintf(stderr, "[audio] %s (bridge %.1f ms)\n", paused ? "pause: fade out" : "resume", fill);
 }
 
