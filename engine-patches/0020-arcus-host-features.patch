+/* Host pause (audio_pause): set under the device lock. The callback fades the
+ * real output to silence over PAUSE_FADE_FRAMES, then emits silence without
+ * pulling the bridge (a starved bridge would conceal by looping recent audio). */
+#define PAUSE_FADE_FRAMES 480   /* 10 ms at 48 kHz */
+static int s_hold = 0;
+static int s_hold_fade = 0;     /* frames of fade left; callback-owned while held */
+
 static void genesis_audio_callback(void *user, Uint8 *stream, int len)
 {
     (void)user;
+    int frames = len / (int)(2 * sizeof(int16_t)); /* stereo S16 */
     if (!s_bridge_ready) { memset(stream, 0, (size_t)len); return; }
-    int frames = len / (int)(2 * sizeof(int16_t)); /* stereo S16 */
+    if (s_hold) {
+        int16_t *out = (int16_t *)stream;
+        int n = s_hold_fade < frames ? s_hold_fade : frames;
+        if (n > 0) {
+            rab_pull(&s_bridge, out, n);
+            for (int i = 0; i < n; i++, s_hold_fade--) {
+                int g = s_hold_fade - 1;              /* PAUSE_FADE_FRAMES-1 .. 0 */
+                out[2 * i]     = (int16_t)(out[2 * i] * g / PAUSE_FADE_FRAMES);
+                out[2 * i + 1] = (int16_t)(out[2 * i + 1] * g / PAUSE_FADE_FRAMES);
+            }
+        }
+        memset(out + 2 * n, 0, (size_t)(frames - n) * 2 * sizeof(int16_t));
+        return;
+    }
     Uint64 begin = SDL_GetPerformanceCounter();
     rab_pull(&s_bridge, (int16_t *)stream, frames);
     uint32_t elapsed = (uint32_t)((SDL_GetPerformanceCounter() - begin)
@@ -254,23 +275,29 @@
