From b5bef463ee9256d8705aa533fe6f3267f40b27a4 Mon Sep 17 00:00:00 2001
From: sixtyeightk <sixtyeightk@users.noreply.github.com>
Date: Sun, 25 Oct 2026 17:53:10 -0400
Subject: [PATCH 02/18] E2: input scripts accept X Y Z MODE (6-button pad)

---
 runner/input_script.c | 32 ++++++++++++++++++++------------
 runner/input_script.h |  4 +++-
 runner/main.c         |  5 +++--
 3 files changed, 26 insertions(+), 15 deletions(-)

diff --git a/runner/input_script.c b/runner/input_script.c
index f3ffb2d..3bc27b9 100644
--- a/runner/input_script.c
+++ b/runner/input_script.c
@@ -50,7 +50,7 @@ typedef struct {
     OpCode    op;
     uint32_t  arg32;       /* WAIT count, RAM addr, EXIT code */
     uint32_t  arg32b;      /* RAM expected value, PRESS frames */
-    uint8_t   button_mask; /* HOLD/RELEASE/PRESS button bit */
+    uint16_t  button_mask; /* HOLD/RELEASE/PRESS button bit (GPAD_* layout) */
     int       line_no;     /* source line for error messages */
     char      str[260];    /* path/string argument */
 } ScriptOp;
@@ -64,7 +64,7 @@ static int      s_op_count = 0;
 static int      s_pc       = 0;     /* next op to execute */
 static int      s_active   = 0;
 static uint64_t s_wait_until_frame = 0;
-static uint8_t  s_held_mask[SCRIPT_PLAYERS];
+static uint16_t s_held_mask[SCRIPT_PLAYERS];
 static uint8_t  s_players_used[SCRIPT_PLAYERS];
 static unsigned s_parse_player;
 static int      s_exit_pending     = 0;
@@ -76,11 +76,12 @@ static char     s_pending_ram_dump[260];
 static char     s_pending_vram_dump[260];
 
 /* One deadline per button/player: presses cannot exhaust a small timer pool. */
-static uint64_t s_press_until[SCRIPT_PLAYERS][8];
+#define SCRIPT_BUTTONS 12   /* 8 + the 6-button pad's X Y Z MODE */
+static uint64_t s_press_until[SCRIPT_PLAYERS][SCRIPT_BUTTONS];
 
 /* ---- Button name parsing ---- */
 
-static int parse_button(const char *s, uint8_t *out) {
+static int parse_button(const char *s, uint16_t *out) {
     if      (!_stricmp(s, "UP"))    *out = 1u << 0;
     else if (!_stricmp(s, "DOWN"))  *out = 1u << 1;
     else if (!_stricmp(s, "LEFT"))  *out = 1u << 2;
@@ -89,6 +90,10 @@ static int parse_button(const char *s, uint8_t *out) {
     else if (!_stricmp(s, "C"))     *out = 1u << 5;
     else if (!_stricmp(s, "A"))     *out = 1u << 6;
     else if (!_stricmp(s, "START")) *out = 1u << 7;
+    else if (!_stricmp(s, "X"))     *out = 1u << 8;
+    else if (!_stricmp(s, "Y"))     *out = 1u << 9;
+    else if (!_stricmp(s, "Z"))     *out = 1u << 10;
+    else if (!_stricmp(s, "MODE"))  *out = 1u << 11;
     else return 0;
     return 1;
 }
@@ -138,7 +143,7 @@ static int parse_line(char *line, int line_no) {
         if (n >= 2) {
             if (!parse_button(a1, &o->button_mask)) goto bad;
         } else {
-            o->button_mask = 0xFF;  /* sentinel: release all */
+            o->button_mask = 0xFFF; /* sentinel: release all */
         }
     } else if (!_stricmp(tok, "PRESS") && n >= 3) {
         if (!parse_button(a1, &o->button_mask)) goto bad;
@@ -241,9 +246,9 @@ void input_script_tick(uint64_t frame,
 
     /* Auto-release any PRESS that has timed out. */
     for (unsigned p = 0; p < SCRIPT_PLAYERS; ++p) {
-        for (unsigned b = 0; b < 8; ++b) {
+        for (unsigned b = 0; b < SCRIPT_BUTTONS; ++b) {
             if (s_press_until[p][b] && frame >= s_press_until[p][b]) {
-                s_held_mask[p] &= (uint8_t)~(1u << b);
+                s_held_mask[p] &= (uint16_t)~(1u << b);
                 s_press_until[p][b] = 0;
             }
         }
@@ -264,23 +269,23 @@ void input_script_tick(uint64_t frame,
 
             case OP_HOLD:
                 s_held_mask[o->arg32] |= o->button_mask;
-                for (unsigned b = 0; b < 8; ++b)
+                for (unsigned b = 0; b < SCRIPT_BUTTONS; ++b)
                     if (o->button_mask & (1u << b)) s_press_until[o->arg32][b] = 0;
                 s_pc++;
                 break;
 
             case OP_RELEASE:
-                s_held_mask[o->arg32] &= (uint8_t)~o->button_mask;
-                for (unsigned b = 0; b < 8; ++b)
+                s_held_mask[o->arg32] &= (uint16_t)~o->button_mask;
+                for (unsigned b = 0; b < SCRIPT_BUTTONS; ++b)
                     if (o->button_mask & (1u << b)) s_press_until[o->arg32][b] = 0;
                 s_pc++;
                 break;
 
             case OP_PRESS: {
-                for (unsigned b = 0; b < 8; ++b) {
+                for (unsigned b = 0; b < SCRIPT_BUTTONS; ++b) {
                     if (!(o->button_mask & (1u << b))) continue;
                     if (o->arg32b) s_held_mask[o->arg32] |= o->button_mask;
-                    else s_held_mask[o->arg32] &= (uint8_t)~o->button_mask;
+                    else s_held_mask[o->arg32] &= (uint16_t)~o->button_mask;
                     s_press_until[o->arg32][b] = o->arg32b ? frame + o->arg32b : 0;
                 }
                 s_pc++;
@@ -398,6 +403,9 @@ void input_script_tick(uint64_t frame,
 }
 
 uint8_t input_script_player_mask(int player) {
+    return (uint8_t)input_script_player_mask16(player);
+}
+uint16_t input_script_player_mask16(int player) {
     return s_active && player >= 0 && player < SCRIPT_PLAYERS ? s_held_mask[player] : 0;
 }
 bool input_script_player_used(int player) {
diff --git a/runner/input_script.h b/runner/input_script.h
index cbb4510..ced25cd 100644
--- a/runner/input_script.h
+++ b/runner/input_script.h
@@ -25,7 +25,7 @@
  *   DUMP_VRAM   <path>   dump the VDP's raw 64KB VRAM
  *   EXIT [code]          exit cleanly with optional status code
  *
- * BUTTON names: UP DOWN LEFT RIGHT A B C START
+ * BUTTON names: UP DOWN LEFT RIGHT A B C START, and X Y Z MODE (6-button pad)
  *
  * Loaded once at startup via input_script_load(). Each wall frame
  * the runner calls input_script_tick(frame). Held-button state is
@@ -74,6 +74,8 @@ void input_script_tick(uint64_t frame,
  */
 uint8_t input_script_held_mask(void);
 uint8_t input_script_player_mask(int player);
+/* All 12 buttons in GPAD_* layout (X=0x100 Y=0x200 Z=0x400 MODE=0x800). */
+uint16_t input_script_player_mask16(int player);
 bool input_script_player_used(int player);
 
 /* True iff the script ran an EXIT directive. The caller should
diff --git a/runner/main.c b/runner/main.c
index 8d5b733..684db7f 100644
--- a/runner/main.c
+++ b/runner/main.c
@@ -881,7 +881,8 @@ static uint16_t collect_pad_mask(int player)
     for (i = 0; i < 8; ++i)
         if (input_requested_cb(NULL, (cc_u8f)player, buttons[i])) mask |= bits[i];
     if (g_input_map.p[player].pad_type == PAD_6BUTTON)
-        mask |= input_current_mask(player) & (GPAD_X | GPAD_Y | GPAD_Z | GPAD_MODE);
+        mask |= (input_current_mask(player) | input_script_player_mask16(player)) &
+                (GPAD_X | GPAD_Y | GPAD_Z | GPAD_MODE);
 #if GENESIS_HAS_RECOMP_NET
     s_sampling_netplay_local = 0;
 #endif
@@ -916,7 +917,7 @@ static void collect_sim_input(GenesisSimInput *in)
                              : input_current_mask(port)) &
                         (GPAD_X | GPAD_Y | GPAD_Z | GPAD_MODE);
 #else
-            pad_mask |= input_current_mask(port) &
+            pad_mask |= (input_current_mask(port) | input_script_player_mask16(port)) &
                         (GPAD_X | GPAD_Y | GPAD_Z | GPAD_MODE);
 #endif
         in->pad[port] = pad_mask;
-- 
