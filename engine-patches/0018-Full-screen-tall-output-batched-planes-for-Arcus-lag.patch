 /* ---- VRAM/CRAM/VSRAM word access ------------------------------------------ */
 /* VRAM word write carries the documented byte-swap on odd addresses. */
+static void tall_write_word(GVDP *v, uint16_t addr, uint16_t value);
+static uint16_t vram_read_word(const GVDP *v, uint16_t addr);
+
+/* A normal-VRAM write into a map plane's name table ($C000 plane A / $E000 plane B, 64x32)
+ * while that plane is tall. A write at the table's first word starts a clear or a whole new
+ * table (e.g. a boss backdrop): the plane is normal again. Any other write is an overlay
+ * (a banner over the map): mirror it into the tall plane at the cell that shows at the same
+ * screen position under the current scroll, so it lands on top of the map as on hardware. */
+static void note_normal_nt_write(GVDP *v, uint16_t addr, uint16_t value)
+{
+    unsigned plane = (addr & 0xF000) == 0xC000 ? 0 : (addr & 0xF000) == 0xE000 ? 1 : 2;
+    if (plane > 1 || !(v->tall_written & (1u << plane))) return;
+    unsigned off = addr & 0x0FFF;
+    if (off < 2) { v->tall_written &= (uint8_t)~(1u << plane); return; }
+    int row = (int)(off >> 7), col = (int)((off & 0x7F) >> 1);
+    int vs = v->vsram[plane] & 0x3FF;
+    uint16_t hbase = (uint16_t)((REG_HSCROLL_NT(v) & 0x3F) << 10);
+    int hs = vram_read_word(v, (uint16_t)(hbase + plane * 2)) & 0x3FF;
+    int top = vs >> 3, left = ((-hs) & 0x3FF) >> 3;      /* cells at screen (0, 0) */
+    int dr = (row - top) & 31, dc = (col - left) & 63;
+    if (dc >= 56) dc -= 64;                              /* just left of the screen */
+    int trow = (top + dr) & 63, tcol = (left + dc) & 127;
+    unsigned toff = (plane ? GVDP_TALL_PLANE_B : GVDP_TALL_PLANE_A) - GVDP_TALL_BASE
+                    + (unsigned)(trow * 256 + tcol * 2);
+    tall_write_word(v, (uint16_t)toff, (uint16_t)((addr & 1) ? (value << 8 | value >> 8) : value));
+}
