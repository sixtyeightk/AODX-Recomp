+/* Render plane/sprite row `line` (window row `win_line`) and emit it as output row `out`. */
+static void emit_row(GenesisMachine *m, GenesisScanlineSink sink, void *user,
+                     int line, int win_line, int out)
+{
+    int n = gvdp_render_scanline_ex(&m->vdp, line, win_line, s_idxbuf);
+    const uint32_t *host_palette = gvdp_host_palette();
+    if (host_palette)
+        memcpy(s_cram_argb + GVDP_HOST_PALETTE_BASE, host_palette,
+               GVDP_HOST_PALETTE_SIZE * sizeof(uint32_t));
+    else if (gvdp_ext_active())          /* extended sprite lines, per row (water) */
+        for (int k = 0; k < GVDP_EXT_LINES * 16; k++)
+            s_cram_argb[GVDP_HOST_PALETTE_BASE + k] =
+                bgr9_to_argb(gvdp_ext_color(line, 1 + k / 16, k % 16), 0);
+    for (int x = 0; x < n; x++) s_rowbuf[x] = s_cram_argb[s_idxbuf[x]];
+    sink(user, out, s_rowbuf, n);
+}
+
+static void emit_black(GenesisMachine *m, GenesisScanlineSink sink, void *user, int out)
+{
+    int n = gvdp_active_width(&m->vdp);
+    for (int x = 0; x < n; x++) s_rowbuf[x] = 0xFF000000u;
+    sink(user, out, s_rowbuf, n);
+}
+
+/* Tall output (gvdp_set_tall, native extension): emit raster line `line` and,
+ * around it, the extra rows. Frames with tall planes show the map above line 0
+ * and below the last line, with the bottom window band (the HUD) moved to the
+ * last output rows; other frames are centred between black rows. */
+static void emit_tall(GenesisMachine *m, GenesisScanlineSink sink, void *user,
+                      int line, int active_h)
+{
+    int H = gvdp_tall_height();
+    if (!gvdp_tall_rows()) {
+        int pad = (H - active_h) / 2;
+        if (line == 0) for (int o = 0; o < pad; o++) emit_black(m, sink, user, o);
+        emit_row(m, sink, user, line, line, line + pad);
+        if (line == active_h - 1)
+            for (int o = pad + active_h; o < H; o++) emit_black(m, sink, user, o);
+        return;
+    }
+    int T = gvdp_tall_top();
+    unsigned wy = m->vdp.reg[0x12];
+    int hud = (wy & 0x80) ? active_h - (int)(wy & 0x1F) * 8 : 0;   /* window band at the bottom */
+    if (hud < 0) hud = 0;
+    int first = line == 0 ? -T : line;
+    int last = line == active_h - 1 ? H - T - 1 : line;
+    for (int g = first; g <= last; g++) {
+        int o = g + T;
+        int win = !hud ? g : (o >= H - hud ? active_h - hud + (o - (H - hud)) : -1);
+        emit_row(m, sink, user, g, win, o);
+    }
+}
