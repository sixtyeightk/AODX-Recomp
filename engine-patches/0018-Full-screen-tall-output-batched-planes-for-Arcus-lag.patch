+/* Native tall-plane VRAM (A16 set): only $10000-$17FFF exists; other A16
+ * addresses read 0 and ignore writes. */
+static void tall_write_word(GVDP *v, uint16_t addr, uint16_t value)
+{
+    unsigned a = (unsigned)(addr & 0xFFFE);      /* offset from $10000 */
+    if (a >= GVDP_TALL_BYTES) return;
+    v->tall_written |= a < (GVDP_TALL_PLANE_B - GVDP_TALL_BASE) ? 1u : 2u;
+    if (addr & 1) { v->vram_tall[a] = (uint8_t)value; v->vram_tall[a + 1] = (uint8_t)(value >> 8); }
+    else          { v->vram_tall[a] = (uint8_t)(value >> 8); v->vram_tall[a + 1] = (uint8_t)value; }
+}
+
+/* Name-table word at a 17-bit address (bit 16 = tall VRAM). */
+static inline uint16_t nt_read_word(const GVDP *v, uint32_t addr)
+{
+    if (!(addr & 0x10000)) return vram_read_word(v, (uint16_t)addr);
+    uint32_t a = (addr & 0x1FFFE) - GVDP_TALL_BASE;
+    if (a >= GVDP_TALL_BYTES) return 0;
+    return (uint16_t)((v->vram_tall[a] << 8) | v->vram_tall[a + 1]);
+}
