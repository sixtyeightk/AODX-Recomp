/* rom_embed.S — links the patched ROM into the executable (generated by CMake
 * from rom_embed.S.in; the path below is the build's ROM, never committed). */
#if defined(__APPLE__)
#define SYM(x) _##x
        .section __TEXT,__const
#else
#define SYM(x) x
        .section .rodata
#endif
        .globl  SYM(arcus_rom_data)
        .globl  SYM(arcus_rom_end)
        .p2align 4
SYM(arcus_rom_data):
        .incbin "@ARCUS_ROM_EMBED@"
SYM(arcus_rom_end):
#if !defined(__APPLE__)
        .section .note.GNU-stack,"",%progbits
#endif
