/* shader_embed.S — links shaders/crt.glsl into the executable as a
 * NUL-terminated string (generated by CMake from shader_embed.S.in). */
#if defined(__APPLE__)
#define SYM(x) _##x
        .section __TEXT,__const
#else
#define SYM(x) x
        .section .rodata
#endif
        .globl  SYM(arcus_crt_glsl)
SYM(arcus_crt_glsl):
        .incbin "@ARCUS_CRT_GLSL@"
        .byte   0
#if !defined(__APPLE__)
        .section .note.GNU-stack,"",%progbits
#endif
